#!/usr/bin/env bash
# memsearch-mini CLI entry point: runs the CLI from this checkout through uv, so the
# hooks and the CLI can never come from different installs.
#
#   bin/memsearch-mini --sync      blocking `uv sync` (installer and diagnostics)
#   bin/memsearch-mini <args...>   forwarded to the CLI
set -uo pipefail

# Resolve the symlink chain without `readlink -f` (absent on BSD/macOS).
_self="${BASH_SOURCE[0]}"
_hops=0
while [ -L "$_self" ] && [ "$_hops" -lt 40 ]; do
  _link="$(readlink "$_self" 2>/dev/null)" || break
  case "$_link" in
    /*) _self="$_link" ;;
    *) _self="$(dirname "$_self")/$_link" ;;
  esac
  _hops=$((_hops + 1))
done
_BIN_DIR="$(cd "$(dirname "$_self")" && pwd -P)"
source "$_BIN_DIR/../hooks/common.sh"
export MEMSEARCH_MINI_PLUGIN_ROOT="$ROOT"

have_uv || {
  echo "[memsearch-mini] uv not found; install it from https://docs.astral.sh/uv/" >&2
  exit 1
}

if [ "${1:-}" = "--sync" ]; then
  if sync_now; then
    echo "[memsearch-mini] runtime ready: $VENV"
    exit 0
  fi
  # A concurrent hook may hold the lock and have finished the work for us.
  if venv_ready; then
    echo "[memsearch-mini] runtime already synced by another process: $VENV"
    exit 0
  fi
  echo "[memsearch-mini] sync failed; see $SYNC_LOG" >&2
  exit 1
fi

if [ "${1:-}" = "hook" ]; then
  # A hook budget is 5-30 seconds; a cold sync is minutes. The launcher already
  # gated on venv_ready, so reaching this means the answer flipped in between (a
  # touched uv.lock, a rewritten stamp). Same policy as hooks/stop.sh: print one
  # JSON object, lose this turn on purpose, and let SessionStart do the install.
  venv_ready || {
    printf '%s\n' '{}'
    exit 0
  }
else
  venv_ready || sync_now || {
    echo "[memsearch-mini] runtime not ready; see $SYNC_LOG" >&2
    exit 1
  }
fi
exec uv run --project "$ROOT" --frozen --no-sync $(extras_args) memsearch-mini ${1+"$@"}
